<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!-- 浅色主题：默认 -->
    <style name="AppTheme_Light" parent="@android:style/Theme.Material.Light.NoActionBar">
        <item name="android:colorBackground">@color/bg_light</item>
        <item name="android:windowBackground">@color/bg_light</item>
        <item name="android:textColorPrimary">@color/ink_light</item>
        <item name="android:textColorSecondary">@color/ink_light</item>
        <item name="android:colorAccent">@color/accent_light</item>
        <item name="android:statusBarColor">@color/bg_light</item>
        <item name="android:navigationBarColor">@color/bg_light</item>
        <item name="android:windowLightStatusBar">true</item>
    </style>

    <!-- 深色主题：设置里选「深色」时由 BaseActivity 切过来 -->
    <style name="AppTheme_Dark" parent="@android:style/Theme.Material.NoActionBar">
        <item name="android:colorBackground">@color/bg_dark</item>
        <item name="android:windowBackground">@color/bg_dark</item>
        <item name="android:textColorPrimary">@color/ink_dark</item>
        <item name="android:textColorSecondary">@color/ink2_dark</item>
        <item name="android:colorAccent">@color/accent_dark</item>
        <item name="android:statusBarColor">@color/bg_dark</item>
        <item name="android:navigationBarColor">@color/bg_dark</item>
    </style>

</resources>
